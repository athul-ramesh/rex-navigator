#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import pty
import select
import shutil
import struct
import subprocess
import sys
import termios
import time
from dataclasses import dataclass
from pathlib import Path
from typing import AbstractSet, NoReturn

PATH_FALLBACKS = [
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    str(
        Path.home()
        / "Library/Application Support/com.superlogical.rex"
        / "RexServer/Versions/Current/Rex Server.app/Contents/MacOS"
    ),
]


def find_bin(name: str) -> str | None:
    paths = os.environ.get("PATH", "")
    for prefix in PATH_FALLBACKS:
        if prefix not in paths.split(os.pathsep):
            paths = paths + os.pathsep + prefix
    return shutil.which(name, path=paths)


def run(argv: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, **kw)


def fail(msg: str, advice: str = "") -> NoReturn:
    print(msg)
    if advice:
        print(advice)
    print("\nPress Enter to close… ", flush=True)
    try:
        sys.stdin.readline()
    except Exception:
        pass
    sys.exit(0)


@dataclass(frozen=True)
class CanonicalPath:
    value: str

    @staticmethod
    def from_user_path(raw: str) -> CanonicalPath:
        path = os.path.realpath(raw)
        if not os.path.isdir(path):
            raise ValueError(f"not a directory: {path}")
        return CanonicalPath(path)


@dataclass(frozen=True)
class SessionLabel:
    value: str


@dataclass(frozen=True)
class TtySize:
    columns: int

    @staticmethod
    def _ioctl_columns(fd: int) -> int | None:
        try:
            buf = fcntl.ioctl(fd, termios.TIOCGWINSZ, struct.pack("HHHH", 0, 0, 0, 0))
            _rows, cols, _xpix, _ypix = struct.unpack("HHHH", buf)
            if cols >= 1:
                return cols
        except OSError:
            pass
        return None

    @staticmethod
    def read() -> TtySize:
        for stream in (sys.stdout, sys.stderr):
            try:
                if stream.isatty():
                    cols = TtySize._ioctl_columns(stream.fileno())
                    if cols is not None:
                        return TtySize(cols)
            except (AttributeError, ValueError, OSError):
                pass
        try:
            with open("/dev/tty", "rb", buffering=0) as tty:
                cols = TtySize._ioctl_columns(tty.fileno())
                if cols is not None:
                    return TtySize(cols)
        except OSError:
            pass
        size = shutil.get_terminal_size(fallback=(80, 24))
        columns = size.columns if size.columns >= 1 else 80
        return TtySize(columns)


@dataclass(frozen=True)
class ItemColumns:
    value: int


@dataclass(frozen=True)
class _FzfFrame:
    margin_y: int
    margin_x: int
    border_cols: int
    scrollbar_cols: int
    pointer_cols: int
    gutter_cols: int
    min_gap: int
    prompt: str
    header: str

    def argv_tail(self, header: str | None = None) -> list[str]:
        border = "rounded" if self.border_cols else "none"
        h = self.header if header is None else header
        return [
            "--ansi",
            f"--margin={self.margin_y},{self.margin_x}",
            f"--border={border}",
            "--delimiter=\t",
            "--with-nth=2",
            "--layout=reverse",
            f"--prompt={self.prompt}",
            f"--header={h}",
        ]

    def item_columns(self, tty: TtySize) -> ItemColumns:
        chrome = (
            2 * self.margin_x
            + 2 * self.border_cols
            + self.scrollbar_cols
            + self.pointer_cols
            + self.gutter_cols
        )
        usable = tty.columns - chrome
        return ItemColumns(max(1, usable))


_SESH_FZF_FRAME = _FzfFrame(
    margin_y=1,
    margin_x=2,
    border_cols=1,
    scrollbar_cols=1,
    pointer_cols=1,
    gutter_cols=2,
    min_gap=2,
    prompt="zoxide ❯ ",
    header="",
)

_ELLIPSIS = "…"
_WIRE_OPEN = "o"
_WIRE_DIR = "d"


def _cols(text: str) -> int:
    return len(text)


def _sanitize(text: str) -> str:
    return "".join(" " if ord(ch) < 32 else ch for ch in text)


def _fit(text: str, budget: int, keep: str) -> tuple[str, int]:
    width = _cols(text)
    if width <= budget:
        return text, width
    if budget <= 0:
        return "", 0
    ell_w = _cols(_ELLIPSIS)
    if budget <= ell_w:
        return (_ELLIPSIS[:budget], budget)
    piece = budget - ell_w
    if keep == "head":
        out = text[:piece] + _ELLIPSIS
    else:
        out = _ELLIPSIS + text[width - piece :]
    return out, _cols(out)


def _layout_row(label: str, path_pretty: str, pane: int, min_gap: int) -> str:
    raw_label = _sanitize(label)
    raw_path = _sanitize(path_pretty)
    lw, pw = _cols(raw_label), _cols(raw_path)
    if lw + min_gap + pw <= pane:
        gap = pane - lw - pw
        return raw_label + (" " * gap) + raw_path
    leftover = pane - lw - min_gap
    if leftover >= 1 and lw + min_gap <= pane:
        path_text, path_w = _fit(raw_path, leftover, "tail")
        gap = pane - lw - path_w
        return raw_label + (" " * gap) + path_text
    head, _ = _fit(raw_label, pane, "head")
    return head


@dataclass(frozen=True)
class InvokeContext:
    session_id: str
    block_id: str
    client_id: str


@dataclass(frozen=True)
class SessionRef:
    session_id: str


@dataclass(frozen=True)
class AppClientId:
    value: str


class RexListError(Exception):
    pass


class ZoxideError(Exception):
    pass


class ActionError(Exception):
    def __init__(self, message: str, advice: str = "") -> None:
        super().__init__(message)
        self.message = message
        self.advice = advice


@dataclass(frozen=True)
class OpenSession:
    ref: SessionRef
    label: SessionLabel

    def display(self, pane: int) -> str:
        text, _ = _fit(_sanitize(self.label.value), pane, "head")
        return text


@dataclass(frozen=True)
class DirectoryLaunch:
    path: CanonicalPath
    label: SessionLabel

    def display(self, pane: int, min_gap: int) -> str:
        return _layout_row(self.label.value, pretty(self.path.value), pane, min_gap)


@dataclass(frozen=True)
class Decision:
    choice: OpenSession | DirectoryLaunch


@dataclass(frozen=True)
class LiveSessions:
    sessions: tuple[OpenSession, ...]

    @staticmethod
    def load(rex: str) -> LiveSessions:
        r = run([rex, "ls", "--json"])
        if r.returncode != 0:
            raise RexListError(
                f"rex ls failed: {r.stderr.strip() or r.stdout.strip()}"
            )
        try:
            data = json.loads(r.stdout)
        except json.JSONDecodeError as e:
            raise RexListError(f"rex ls returned invalid JSON: {e}") from e
        if not isinstance(data, dict):
            raise RexListError("rex ls returned unexpected payload")
        raw_list = data.get("sessions") or []
        if not isinstance(raw_list, list):
            raise RexListError("rex ls sessions field is not a list")
        out: list[OpenSession] = []
        for item in raw_list:
            if not isinstance(item, dict):
                continue
            sid = item.get("session_id")
            label = item.get("label")
            if not isinstance(sid, str) or not sid:
                continue
            if not isinstance(label, str) or not label:
                continue
            out.append(OpenSession(SessionRef(sid), SessionLabel(label)))
        return LiveSessions(tuple(out))

    def labels(self) -> frozenset[str]:
        return frozenset(s.label.value for s in self.sessions)


@dataclass(frozen=True)
class PickerBoard:
    open_sessions: tuple[OpenSession, ...]
    launches: tuple[DirectoryLaunch, ...]

    @staticmethod
    def load(rex: str, zox: str) -> PickerBoard:
        live = LiveSessions.load(rex)
        paths = zoxide_dirs(zox)
        return PickerBoard.build(live, paths)

    @staticmethod
    def build(live: LiveSessions, paths: list[CanonicalPath]) -> PickerBoard:
        label_set = live.labels()
        launches = tuple(
            DirectoryLaunch(
                path=p,
                label=session_label_for(p, label_set),
            )
            for p in paths
        )
        return PickerBoard(open_sessions=live.sessions, launches=launches)

    def is_empty(self) -> bool:
        return not self.open_sessions and not self.launches

    def choose(self, fzf: str, rex: str, ctx: InvokeContext) -> None:
        decision = self._pick(fzf)
        if decision is None:
            return
        apply_decision(rex, ctx, decision)

    def _pick(self, fzf: str) -> Decision | None:
        tty = TtySize.read()
        token = hashlib.sha256(f"{time.time_ns()}".encode()).hexdigest()[:8]
        listing = self._render_source(token, tty)
        argv = self._fzf_argv(fzf)
        proc = subprocess.run(
            argv,
            input=listing.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if proc.returncode in (1, 130) or not proc.stdout.strip():
            return None
        if proc.returncode != 0:
            err = (proc.stderr + proc.stdout).decode("utf-8", "replace").strip()
            raise ActionError(f"fzf failed: {err}")
        raw = proc.stdout.decode("utf-8", "replace").strip()
        return self._decision_from_stdout(token, raw)

    def _render_source(self, token: str, tty: TtySize) -> str:
        pane = _SESH_FZF_FRAME.item_columns(tty).value
        min_gap = _SESH_FZF_FRAME.min_gap
        lines: list[str] = []
        for i, session in enumerate(self.open_sessions):
            cid = f"{token}{_WIRE_OPEN}{i}"
            display = session.display(pane)
            lines.append(f"{cid}\t{display}")
        for i, launch in enumerate(self.launches):
            cid = f"{token}{_WIRE_DIR}{i}"
            display = launch.display(pane, min_gap)
            lines.append(f"{cid}\t{display}")
        return "\n".join(lines) + "\n"

    def _decision_from_stdout(self, token: str, raw: str) -> Decision | None:
        cid = raw.split("\t", 1)[0].strip()
        if not cid.startswith(token) or len(cid) <= len(token):
            return None
        rest = cid[len(token) :]
        if not rest:
            return None
        kind, idx_s = rest[0], rest[1:]
        if not idx_s.isdigit():
            return None
        idx = int(idx_s)
        if kind == _WIRE_OPEN:
            if 0 <= idx < len(self.open_sessions):
                return Decision(self.open_sessions[idx])
            return None
        if kind == _WIRE_DIR:
            if 0 <= idx < len(self.launches):
                return Decision(self.launches[idx])
            return None
        return None

    def _header(self) -> str:
        has_open = bool(self.open_sessions)
        has_dirs = bool(self.launches)
        if has_open and has_dirs:
            return (
                "enter: switch open session or create from a directory · esc: cancel"
            )
        if has_open:
            return "enter: switch session · esc: cancel"
        return "enter: new session · esc: cancel"

    def _fzf_argv(self, fzf_bin: str) -> list[str]:
        argv = [fzf_bin, *_SESH_FZF_FRAME.argv_tail(self._header())]
        if self.open_sessions and self.launches:
            argv.append("--no-sort")
        return argv


def zoxide_dirs(zox: str) -> list[CanonicalPath]:
    r = run([zox, "query", "--list"])
    if r.returncode != 0:
        raise ZoxideError(f"zoxide query failed: {r.stderr.strip()}")
    seen: set[str] = set()
    out: list[CanonicalPath] = []
    for line in r.stdout.splitlines():
        raw = line.strip()
        if not raw or not os.path.isdir(raw):
            continue
        canon = os.path.realpath(raw)
        if canon in seen:
            continue
        seen.add(canon)
        out.append(CanonicalPath(canon))
    return out


def session_label_for(path: CanonicalPath, live_labels: AbstractSet[str]) -> SessionLabel:
    base = os.path.basename(path.value.rstrip("/")) or path.value
    if base in live_labels:
        digest = hashlib.sha256(path.value.encode()).hexdigest()[:6]
        base = f"{base}-{digest}"
    return SessionLabel(base)


def pretty(path: str) -> str:
    home = str(Path.home())
    if path == home or path.startswith(home + "/"):
        return "~" + path[len(home) :]
    return path


def apply_decision(rex: str, ctx: InvokeContext, decision: Decision) -> None:
    choice = decision.choice
    if isinstance(choice, OpenSession):
        try:
            client = resolve_app_client(rex, ctx.client_id)
        except RuntimeError as e:
            raise ActionError(
                str(e),
                "That session is still open. Pick it from the sidebar.",
            ) from e
        perform_session_select(rex, client, choice.ref, created=None)
        return

    if isinstance(choice, DirectoryLaunch):
        try:
            path = CanonicalPath.from_user_path(choice.path.value)
        except ValueError as e:
            raise ActionError(str(e)) from e
        try:
            session = create_session(rex, choice.label, path)
        except RuntimeError as e:
            raise ActionError(f"creating session failed: {e}") from e
        try:
            client = resolve_app_client(rex, ctx.client_id)
        except RuntimeError as e:
            raise ActionError(
                str(e),
                f"The session {session.session_id} was created; open it from the sidebar.",
            ) from e
        perform_session_select(rex, client, session, created=session)
        return

    raise ActionError(f"unknown picker choice: {type(choice).__name__}")


def _layout_row_self_check() -> None:
    frame = _SESH_FZF_FRAME

    def assert_row(label: str, path_p: str, pane: int, expect_suffix: str | None, expect_len: int):
        row = _layout_row(label, path_p, pane, frame.min_gap)
        assert "\t" not in row and "\n" not in row, row
        assert _cols(row) <= pane, (row, pane, _cols(row))
        if expect_len is not None:
            assert _cols(row) == expect_len, (row, expect_len)
        if expect_suffix is not None:
            assert row.endswith(expect_suffix), (row, expect_suffix)

    pane = 40
    path = "~/src/rex-navigator"
    row = _layout_row("navigator", path, pane, frame.min_gap)
    assert row.endswith(path)
    assert _cols(row) == pane
    assert row.index(path) > len("navigator")

    long_path = "/" + "x" * 80
    tail_room = pane - len("nav") - frame.min_gap
    expect_tail = _ELLIPSIS + long_path[-(tail_room - 1) :]
    assert_row("nav", long_path, pane, expect_tail, pane)

    assert_row("x" * 50, "/short", pane, None, pane)

    print("layout self-check ok")


def _open_display_self_check() -> None:
    pane = 40
    session = OpenSession(SessionRef("sid"), SessionLabel("navigator"))
    display = session.display(pane)
    assert display == "navigator", display
    assert "\t" not in display and "\n" not in display
    assert _cols(display) <= pane
    long = OpenSession(SessionRef("s2"), SessionLabel("x" * 80))
    clipped = long.display(pane)
    assert _cols(clipped) <= pane
    assert clipped.endswith(_ELLIPSIS)
    print("open display self-check ok")


def _board_source_self_check() -> None:
    live = LiveSessions(
        (OpenSession(SessionRef("sid-open"), SessionLabel("navigator")),)
    )
    board = PickerBoard.build(live, [CanonicalPath(os.getcwd())])
    token = "abcd1234"
    listing = board._render_source(token, TtySize(80))
    lines = [ln for ln in listing.splitlines() if ln.strip()]
    assert len(lines) >= 2, lines
    assert lines[0].split("\t", 1)[1] == "navigator"
    opened = board._decision_from_stdout(token, lines[0])
    assert isinstance(opened, Decision)
    assert isinstance(opened.choice, OpenSession)
    assert opened.choice.ref.session_id == "sid-open"
    launched = board._decision_from_stdout(token, lines[1])
    assert isinstance(launched, Decision)
    assert isinstance(launched.choice, DirectoryLaunch)
    assert board._decision_from_stdout(token, f"{token}o99\tjunk") is None
    argv = board._fzf_argv("fzf")
    assert "--layout=reverse" in argv
    assert "--no-sort" in argv
    print("board source self-check ok")


_FZF_ELLIPSIS = "··"


def _pty_set_cols(fd: int, cols: int, rows: int = 24) -> None:
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def _fzf_pty_layout_check(fzf: str) -> None:
    marker = "/ZZZ_REX_SESH_LAYOUT_MARKER"
    tty = TtySize(80)
    pane = _SESH_FZF_FRAME.item_columns(tty).value
    row = _layout_row("nav", marker, pane, _SESH_FZF_FRAME.min_gap)
    assert _cols(row) == pane, (row, pane, _cols(row))
    assert row.endswith(marker), row
    listing = f"t0\t{row}\n"
    board = PickerBoard.build(LiveSessions(()), [])
    argv = board._fzf_argv(fzf)

    master, slave = pty.openpty()
    _pty_set_cols(master, 80)
    _pty_set_cols(slave, 80)
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE,
            stdout=slave,
            stderr=slave,
            close_fds=True,
        )
    finally:
        os.close(slave)

    captured = bytearray()
    try:
        assert proc.stdin is not None
        proc.stdin.write(listing.encode("utf-8"))
        proc.stdin.close()
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            ready, _, _ = select.select([master], [], [], 0.05)
            if ready:
                chunk = os.read(master, 65536)
                if not chunk:
                    break
                captured.extend(chunk)
            if marker.encode() in captured or _FZF_ELLIPSIS.encode() in captured:
                break
            if proc.poll() is not None:
                break
        if proc.poll() is None:
            proc.kill()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
    finally:
        os.close(master)

    text = captured.decode("utf-8", "replace")
    if _FZF_ELLIPSIS in text:
        raise AssertionError(
            f"fzf line truncation ({_FZF_ELLIPSIS!r}) in pty output at 80 cols"
        )
    if marker not in text:
        raise AssertionError(
            f"path marker missing from fzf pty output at 80 cols (pane={pane})"
        )
    print("fzf pty layout check ok")


def _check_layout() -> None:
    _layout_row_self_check()
    _open_display_self_check()
    _board_source_self_check()
    fzf = find_bin("fzf")
    if not fzf:
        raise SystemExit("missing fzf for pty layout check")
    _fzf_pty_layout_check(fzf)
    chrome = (
        2 * _SESH_FZF_FRAME.margin_x
        + 2 * _SESH_FZF_FRAME.border_cols
        + _SESH_FZF_FRAME.scrollbar_cols
        + _SESH_FZF_FRAME.pointer_cols
        + _SESH_FZF_FRAME.gutter_cols
    )
    assert chrome >= 10, chrome
    assert _SESH_FZF_FRAME.item_columns(TtySize(80)).value == 70, chrome


def create_session(rex: str, label: SessionLabel, path: CanonicalPath) -> SessionRef:
    r = run([rex, "new", label.value, "--cwd", path.value, "--json"])
    if r.returncode != 0:
        raise RuntimeError(f"rex new failed: {r.stderr.strip() or r.stdout.strip()}")
    sid = json.loads(r.stdout).get("session_id")
    if not sid:
        raise RuntimeError("rex new returned no session_id")
    return SessionRef(sid)


def resolve_app_client(rex: str, wanted: str) -> AppClientId:
    r = run([rex, "api", "call", "client.list"])
    if r.returncode != 0:
        raise RuntimeError(f"client list failed: {r.stderr.strip()}")
    clients = json.loads(r.stdout).get("clients", [])
    apps = [
        c
        for c in clients
        if c.get("info", {}).get("kind") == "app"
        and c.get("connection_state", "connected") == "connected"
    ]
    for c in clients:
        if c["client_id"] == wanted:
            if (
                c.get("info", {}).get("kind") == "app"
                and c.get("connection_state", "connected") == "connected"
            ):
                return AppClientId(wanted)
            break
    if len(apps) == 1:
        return AppClientId(apps[0]["client_id"])
    if wanted:
        raise RuntimeError(f"client {wanted} is not a connected Rex app")
    raise RuntimeError(
        "no client given and the connected Rex apps are not exactly one; "
        "the action should pass --client"
    )


def perform_session_select(
    rex: str,
    client: AppClientId,
    session: SessionRef,
    created: SessionRef | None,
) -> None:
    payload = json.dumps(
        {
            "client_id": client.value,
            "action": "session.select",
            "args": {"session_id": session.session_id},
            "origin": "script",
        }
    )
    r = run([rex, "api", "call", "client.perform", "-"], input=payload)
    if r.returncode == 0:
        return
    err = (r.stderr + r.stdout).strip()
    if "Remote Control" in err:
        if created is not None:
            advice = (
                "Enable Remote Control in the Rex app: Settings → Rex Server. "
                f"The session {created.session_id} was created; open it from the sidebar."
            )
        else:
            advice = (
                "Enable Remote Control in the Rex app: Settings → Rex Server. "
                "That session is still open; pick it from the sidebar."
            )
        raise ActionError(f"Rex refused the switch: {err}", advice)
    raise ActionError(f"switching the client failed: {err}")


def require_tools() -> tuple[str, str, str]:
    found: dict[str, str] = {}
    missing: list[str] = []
    for name in ("rex", "fzf", "zoxide"):
        path = find_bin(name)
        if path is None:
            missing.append(name)
        else:
            found[name] = path
    if missing:
        fail(
            f"missing required programs: {', '.join(missing)}",
            "Install them (brew install fzf zoxide) and make sure `rex` is on PATH.",
        )
    return found["rex"], found["fzf"], found["zoxide"]


def parse_args(argv: list[str]) -> InvokeContext:
    ap = argparse.ArgumentParser(description="Rex zoxide session picker helper.")
    ap.add_argument("--session", default="")
    ap.add_argument("--block", default="")
    ap.add_argument("--client", default="")
    args = ap.parse_args(argv)
    return InvokeContext(
        session_id=args.session,
        block_id=args.block,
        client_id=args.client,
    )


def main() -> None:
    ctx = parse_args(sys.argv[1:])
    rex, fzf, zox = require_tools()

    try:
        board = PickerBoard.load(rex, zox)
    except RexListError as e:
        fail(str(e), "Is the Rex server running? Run `rex ls` in a terminal to check.")
        return
    except ZoxideError as e:
        fail(str(e))
        return

    if board.is_empty():
        fail(
            "no open sessions and no zoxide directories",
            "Visit some folders so zoxide has history, or start a Rex session.",
        )
        return

    try:
        board.choose(fzf, rex, ctx)
    except ActionError as e:
        fail(e.message, e.advice)


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] == "--check-layout":
        _check_layout()
        sys.exit(0)
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        fail(f"picker error: {e}")
